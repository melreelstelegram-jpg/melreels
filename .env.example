# Telegram
BOT_TOKEN=
ADMIN_IDS=
WEBAPP_URL=
# Domínio público usado para registrar o webhook do bot (POST /telegraf-webhook/<BOT_TOKEN>).
# Opcional — se vazio, usa https://melreels.com.br.
PUBLIC_URL=

# Postgres (Railway Postgres plugin fornece isso automaticamente)
DATABASE_URL=

# EFI Bank (PIX)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CHAVE_PIX=

# MercadoPago (backup)
MP_ACCESS_TOKEN=

# InfinitePay (2º backup — gera link de checkout, não QR/copia-e-cola direto)
# Handle = sua InfiniteTag, sem o $ (ex: $melreels -> melreels)
INFINITEPAY_HANDLE=

# URLs base dos HDs expostos via Cloudflare Tunnel (ex: https://media.melreels.com.br/filmes)
# Fallback automático para BUNNY/TELEGRAM se o arquivo não responder na URL
STORAGE_PATH_1=
STORAGE_PATH_2=
